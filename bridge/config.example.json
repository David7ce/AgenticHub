{
  "host": "127.0.0.1",
  "port": 3010,
  "authTokenEnv": "AGENT_HUB_BRIDGE_TOKEN",
  "auditLog": "../../logs/bridge.jsonl",
  "systemPrompt": null,
  "agents": {
    "registry": "../acp/agents.json",
    "cwd": "../../logs/hub-bridge",
    "permission": "deny",
    "timeoutMs": 300000,
    "models": [
      {
        "id": "claude",
        "agent": "claude",
        "label": "Claude via AgentHub",
        "contextWindow": 1000000,
        "maxOutputTokens": 64000,
        "sessionMeta": {
          "claudeCode": {
            "options": {
              "settingSources": [],
              "tools": [
                "Read",
                "Glob",
                "Grep"
              ],
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              }
            }
          }
        },
        "streamReasoning": true
      },
      {
        "id": "codex",
        "agent": "codex",
        "label": "Codex via AgentHub",
        "contextWindow": 872000,
        "maxOutputTokens": 128000
      },
      {
        "id": "opencode",
        "agent": "opencode",
        "label": "OpenCode via AgentHub",
        "contextWindow": 1000000,
        "maxOutputTokens": 64000
      }
    ]
  }
}
